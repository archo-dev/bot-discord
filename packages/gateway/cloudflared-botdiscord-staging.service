[Unit]
Description=Cloudflare Tunnel for the botdiscord staging gateway
After=network-online.target botdiscord-gateway-staging.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/botdiscord-gateway-staging.token
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cloudflared/botdiscord-gateway-staging.token

[Install]
WantedBy=multi-user.target
